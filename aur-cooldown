#!/usr/bin/env python3
"""Delay AUR upgrades until they have aged for a configurable number of days.

aur-cooldown installs an AUR update only once it has survived N days (default 7)
in the AUR, so that malicious or broken pushes are caught by the community
before they reach your machine.

Commands:
  observe    record the current version, git commit, and server-side push time
             of every tracked package (cheap; run every few days)
  upgrade    build and install the newest recorded version that has aged past
             the cooldown and is still present in the package's git history
  status     show the eligible aged version next to the current tip
  refresh    re-fetch the configured denylist feeds
  setup      wire the yay hook and shell reminder into your own config

Age is measured with the AUR server's LastModified timestamp, never with git
commit dates (those are set by the committer and were forged in the June 2026
AUR incident). The RPC only exposes LastModified for the current version, so
`observe` accumulates it over time in a local ledger.

Files:
  ~/.config/aur-cooldown/packages        optional explicit package list;
                                         default is every installed AUR package
  ~/.config/aur-cooldown/revoked         local denylist: "<pkg> <version|commit>"
  ~/.config/aur-cooldown/denylist-feeds  optional feed URLs (see README)
  ~/.local/share/aur-cooldown/           ledger and other state
  ~/.cache/aur-cooldown/                 package git clones and build trees

Environment: AUR_COOLDOWN_DAYS overrides the cooldown length.
"""

import argparse
import glob
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

VERSION = "0.6.0"

HOME = os.path.expanduser("~")
XDG_DATA = os.environ.get("XDG_DATA_HOME", os.path.join(HOME, ".local/share"))
XDG_CONFIG = os.environ.get("XDG_CONFIG_HOME", os.path.join(HOME, ".config"))
XDG_CACHE = os.environ.get("XDG_CACHE_HOME", os.path.join(HOME, ".cache"))

STATE = os.environ.get("AUR_COOLDOWN_STATE", os.path.join(XDG_DATA, "aur-cooldown"))
CACHE = os.environ.get("AUR_COOLDOWN_CACHE", os.path.join(XDG_CACHE, "aur-cooldown"))
CONFDIR = os.path.join(XDG_CONFIG, "aur-cooldown")

LEDGER = os.path.join(STATE, "ledger.jsonl")
LASTOBS = os.path.join(STATE, "last-observe")
FEED_CACHE = os.path.join(STATE, "denylist-feed.cache")
PKGCONF = os.path.join(CONFDIR, "packages")
DENY = os.path.join(CONFDIR, "revoked")
FEEDSCONF = os.path.join(CONFDIR, "denylist-feeds")
CONFIGFILE = os.path.join(CONFDIR, "config")

RPC = "https://aur.archlinux.org/rpc/v5/info"
GITBASE = "https://aur.archlinux.org"
UA = f"aur-cooldown/{VERSION}"
DAYS = int(os.environ.get("AUR_COOLDOWN_DAYS", "7"))
RPC_BATCH = 150
GIT_ENV = dict(os.environ, GIT_TERMINAL_PROMPT="0")


def now():
    return int(time.time())


def day(ts):
    return time.strftime("%Y-%m-%d", time.localtime(ts))


def ensure_dirs():
    for d in (STATE, CACHE, CONFDIR):
        os.makedirs(d, exist_ok=True)


def run(cmd, check=True, env=None):
    return subprocess.run(cmd, check=check, env=env, text=True,
                          stdout=subprocess.PIPE, stderr=subprocess.PIPE)


# --- config + privilege escalation -------------------------------------------

def read_config():
    """Parse ~/.config/aur-cooldown/config: 'key = value' lines, # comments."""
    conf = {}
    if os.path.exists(CONFIGFILE):
        for line in open(CONFIGFILE):
            line = line.split("#", 1)[0].strip()
            if "=" in line:
                k, v = line.split("=", 1)
                conf[k.strip()] = v.strip()
    return conf


def resolve_sudo(args):
    """The command used to gain root, mirroring yay's --sudo/--sudoflags.

    Precedence: command line, then the config file, then makepkg's own default
    (sudo if present, else su). We escalate the install ourselves rather than
    hand PACMAN_AUTH to makepkg, because that variable is a bash array makepkg
    reads from its config, not something an exported string can set.
    """
    conf = read_config()
    sudo = args.sudo or conf.get("sudo") or ("sudo" if shutil.which("sudo") else "su")
    flags = args.sudoflags if args.sudoflags is not None else conf.get("sudoflags", "")
    return sudo, shlex.split(flags)


def as_root(cmd, sudo, flags):
    """Wrap a command so it runs as root via the chosen escalator.

    su takes its command as a single string (su [flags] -c '<cmd>'); sudo and
    friends take it as trailing arguments (sudo [flags] <cmd>).
    """
    if os.path.basename(sudo) == "su":
        return [sudo, *flags, "-c", shlex.join(cmd)]
    return [sudo, *flags, *cmd]


def run_root(cmd, sudo, flags):
    """Run a command as root, printing exactly what is being escalated first."""
    full = as_root(cmd, sudo, flags)
    print(f"  running as root: {shlex.join(full)}")
    return subprocess.run(full).returncode


_DEP_LINE = re.compile(r"^\s*(?:make|check)?depends(?:_\w+)?\s*=\s*(.+?)\s*$")


def install_deps(build, sudo, flags):
    """Install any missing repo dependencies of the exported PKGBUILD.

    Returns True if all dependencies are satisfied afterwards. Only official
    repositories are consulted (pacman); an unmet AUR dependency returns False.
    """
    srcinfo = os.path.join(build, ".SRCINFO")
    if not os.path.exists(srcinfo):
        return True
    atoms = []
    for line in open(srcinfo):
        m = _DEP_LINE.match(line)
        if m:
            atoms.append(m.group(1))
    if not atoms:
        return True
    unmet = run(["pacman", "-T", *atoms], check=False).stdout.split()
    names = sorted({re.split(r"[<>=:]", a, 1)[0] for a in unmet})
    if not names:
        return True
    print(f"  installing dependencies: {' '.join(names)}")
    return run_root(["pacman", "-S", "--needed", "--asdeps", "--noconfirm", *names],
                    sudo, flags) == 0


# --- target selection --------------------------------------------------------

def installed_aur():
    """Installed foreign packages, minus -debug split companions.

    The -debug packages are rebuilt with their base package, and some linger
    orphaned after a package moves to the official repos; we never track a
    base name that is not itself installed.
    """
    out = run(["pacman", "-Qm"]).stdout.splitlines()
    return sorted(line.split()[0] for line in out
                  if line.split() and not line.split()[0].endswith("-debug"))


def targets(explicit):
    """Return (names, is_auto); is_auto means the set came from pacman -Qm."""
    if explicit:
        return explicit, False
    if os.path.exists(PKGCONF):
        names = [ln.strip() for ln in open(PKGCONF)
                 if ln.strip() and not ln.strip().startswith("#")]
        if names:
            return sorted(set(names)), False
    return installed_aur(), True


# --- AUR RPC (authoritative timestamps) --------------------------------------

def rpc_info(names):
    """Batched package info; returns {name: {base, version, last_modified}}."""
    res = {}
    for i in range(0, len(names), RPC_BATCH):
        qs = urllib.parse.urlencode([("arg[]", n) for n in names[i:i + RPC_BATCH]])
        req = urllib.request.Request(f"{RPC}?{qs}", headers={"User-Agent": UA})
        with urllib.request.urlopen(req, timeout=30) as resp:
            data = json.load(resp)
        for e in data.get("results", []):
            res[e["Name"]] = {"base": e["PackageBase"], "version": e["Version"],
                              "last_modified": int(e["LastModified"])}
    return res


def ls_remote_head(base):
    r = run(["git", "ls-remote", f"{GITBASE}/{base}.git", "HEAD"],
            check=False, env=GIT_ENV)
    if r.returncode != 0 or not r.stdout.strip():
        return None
    return r.stdout.split()[0]


# --- ledger ------------------------------------------------------------------

def load_ledger():
    rows = []
    if os.path.exists(LEDGER):
        for line in open(LEDGER):
            line = line.strip()
            if not line:
                continue
            try:
                r = json.loads(line)
            except json.JSONDecodeError:
                continue
            if r.get("pkg") and r.get("version") and "last_modified" in r:
                rows.append(r)
    return rows


def base_for(pkg, rows):
    base = ""
    for r in rows:
        if r.get("pkg") == pkg and r.get("base"):
            base = r["base"]
    return base


def aged_versions(pkg, cutoff, rows):
    """Ledger entries for pkg with last_modified <= cutoff, newest first.

    Entries without a bound commit cannot be verified and are ignored.
    """
    seen = {}
    for r in rows:
        if r.get("pkg") != pkg or not r.get("commit"):
            continue
        if int(r["last_modified"]) > cutoff:
            continue
        seen[r["version"]] = (int(r["last_modified"]), r["commit"])
    return sorted(({"version": v, "last_modified": lm, "commit": c}
                   for v, (lm, c) in seen.items()),
                  key=lambda e: e["last_modified"], reverse=True)


def cooling_info(pkg, installed, rows):
    """Why a package has no eligible version yet, for the 'none' case.

    Returns a detail dict: 'cooling' with the version that ages in first and
    the timestamp it becomes eligible, 'unobserved' if we have no record of it
    yet, or 'current' if everything we have observed is already installed.
    """
    newer = {}
    seen_any = False
    for r in rows:
        if r.get("pkg") != pkg or not r.get("commit"):
            continue
        seen_any = True
        v, lm = r["version"], int(r["last_modified"])
        if installed and vercmp(v, installed) <= 0:
            continue
        newer[v] = min(lm, newer.get(v, lm))
    if not newer:
        return {"state": "current" if seen_any else "unobserved"}
    # Whichever newer version was pushed earliest ages in first, and that is
    # what the next 'upgrade' installs; report it and when its cooldown ends.
    version, pushed = min(newer.items(), key=lambda kv: kv[1])
    return {"state": "cooling", "version": version,
            "eligible": pushed + DAYS * 86400}


# --- denylist ----------------------------------------------------------------

def local_denylist():
    entries = []
    if os.path.exists(DENY):
        for line in open(DENY):
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            parts = line.split()
            if len(parts) >= 2:
                entries.append((parts[0], parts[1]))
    return entries


def denied_version(pkg, version, commit, deny):
    for p, token in deny:
        if p != pkg:
            continue
        if token == version:
            return True
        if commit and commit.startswith(token):
            return True
    return False


def load_feed_names():
    names = set()
    if os.path.exists(FEED_CACHE):
        for line in open(FEED_CACHE):
            t = line.strip()
            if t and not t.startswith("#"):
                names.add(t)
    return names


def refresh_feeds():
    """Fetch the configured package-name denylist feeds into the local cache.

    Best-effort by design: if any feed is unreachable, the previous cache is
    kept unchanged. A denylist can only withhold installs, so a stale cache
    errs on the conservative side. Returns the effective frozen-name set.
    """
    if not os.path.exists(FEEDSCONF):
        return load_feed_names()
    urls = [ln.strip() for ln in open(FEEDSCONF)
            if ln.strip() and not ln.strip().startswith("#")]
    if not urls:
        return load_feed_names()
    names = set()
    for url in urls:
        try:
            req = urllib.request.Request(url, headers={"User-Agent": UA})
            with urllib.request.urlopen(req, timeout=30) as resp:
                text = resp.read().decode("utf-8", "replace")
        except (urllib.error.URLError, OSError) as e:
            print(f"aur-cooldown: feed unreachable, keeping cache ({url}): {e}",
                  file=sys.stderr)
            return load_feed_names()
        for line in text.splitlines():
            t = line.strip()
            if t and not t.startswith("#"):
                names.add(t.split()[0])
    ensure_dirs()
    with open(FEED_CACHE, "w") as fh:
        fh.write(f"# fetched {day(now())} from: {' '.join(urls)}\n")
        for n in sorted(names):
            fh.write(n + "\n")
    return names


# --- git ---------------------------------------------------------------------

def sync_repo(base):
    repo = os.path.join(CACHE, base)
    if os.path.isdir(os.path.join(repo, ".git")):
        run(["git", "-C", repo, "fetch", "-q", "origin"], env=GIT_ENV)
        run(["git", "-C", repo, "reset", "-q", "--hard", "@{u}"], env=GIT_ENV)
    else:
        if os.path.exists(repo):
            shutil.rmtree(repo)
        run(["git", "clone", "-q", f"{GITBASE}/{base}.git", repo], env=GIT_ENV)
    return repo


def srcinfo_version(repo, commit):
    r = run(["git", "-C", repo, "show", f"{commit}:.SRCINFO"], check=False)
    if r.returncode != 0:
        return None
    ver = rel = epoch = None
    for line in r.stdout.splitlines():
        if line.startswith("\tpkgver = "):
            ver = line.split(" = ", 1)[1]
        elif line.startswith("\tpkgrel = "):
            rel = line.split(" = ", 1)[1]
        elif line.startswith("\tepoch = "):
            epoch = line.split(" = ", 1)[1]
    if ver is None:
        return None
    return f"{epoch}:{ver}-{rel}" if epoch else f"{ver}-{rel}"


def vercmp(a, b):
    return int(run(["vercmp", a, b]).stdout.strip())


def installed_version(pkg):
    r = run(["pacman", "-Q", pkg], check=False)
    return r.stdout.split()[1] if r.returncode == 0 and r.stdout.split() else None


# --- observe -----------------------------------------------------------------

def cmd_observe(args):
    ensure_dirs()
    open(LEDGER, "a").close()
    names, _ = targets(args.pkgs)
    info = rpc_info(names)
    have = {(r["pkg"], r["version"]) for r in load_ledger()}

    missing = [p for p in names if p not in info]
    fresh = [p for p in names if p in info and (p, info[p]["version"]) not in have]
    added = 0

    if fresh:
        heads = {p: ls_remote_head(info[p]["base"]) for p in fresh}
        # Second RPC snapshot. If version and LastModified are unchanged, no
        # push happened while we read HEAD, so the HEAD commit is the one this
        # timestamp belongs to. Without this, a push landing in the gap could
        # bind an attacker's commit to the previous (older) timestamp.
        confirm = rpc_info(fresh)
        with open(LEDGER, "a") as fh:
            for p in fresh:
                d, d2, sha = info[p], confirm.get(p), heads.get(p)
                if (not sha or not d2
                        or d2["version"] != d["version"]
                        or d2["last_modified"] != d["last_modified"]):
                    print(f"  {p:30} changed while observing, will retry next time")
                    continue
                fh.write(json.dumps({"pkg": p, "base": d["base"],
                                     "version": d["version"], "commit": sha,
                                     "last_modified": d["last_modified"],
                                     "seen_at": now()}) + "\n")
                print(f"  {p:30} {d['version']} @ {sha[:8]} (pushed {day(d['last_modified'])})")
                added += 1

    for p in missing:
        print(f"  {p:30} not in the AUR, skipped")

    if not args.pkgs:  # only a full pass counts as a completed observation
        open(LASTOBS, "w").write(str(now()))
    unchanged = len(names) - len(missing) - len(fresh)
    print(f"\n{added} new version(s) recorded, {unchanged} unchanged, "
          f"{len(missing)} not in the AUR.")

    frozen = sorted(set(names) & refresh_feeds())
    if frozen:
        print("\nWARNING: installed packages found on a denylist feed:")
        for p in frozen:
            print(f"  {p}")
        print("These are frozen; aur-cooldown will not upgrade them. Note that\n"
              "feeds are name-level: being listed means the package was part of\n"
              "a campaign, not necessarily that your installed build is affected.")


# --- upgrade -----------------------------------------------------------------

def resolve(pkg, cutoff, rows, deny, feed, is_auto):
    """Decide what to do for one package.

    Returns (action, detail) where action is one of build, up-to-date, none,
    yanked, denied, not-installed, error.
    """
    installed = installed_version(pkg)
    if installed is None and is_auto:
        return "not-installed", None
    if pkg in feed:
        return "denied", None

    aged = aged_versions(pkg, cutoff, rows)
    if not aged:
        return "none", cooling_info(pkg, installed, rows)

    base = base_for(pkg, rows) or pkg
    repo = ancestry = None
    srcinfo_cache = {}
    saw_yank = False

    for entry in aged:
        v, recorded = entry["version"], entry["commit"]
        if installed and vercmp(v, installed) <= 0:
            return "up-to-date", {"version": installed}
        if denied_version(pkg, v, recorded, deny):
            saw_yank = True
            continue
        if repo is None:
            try:
                repo = sync_repo(base)
            except subprocess.CalledProcessError as e:
                return "error", {"msg": (e.stderr or "git failed").strip()}
            ancestry = run(["git", "-C", repo, "log", "--format=%H", "HEAD"]).stdout.split()

        def srcinfo(commit):
            if commit not in srcinfo_cache:
                srcinfo_cache[commit] = srcinfo_version(repo, commit)
            return srcinfo_cache[commit]

        # All commits in the current canonical history that carry version v.
        # The recorded commit must be among them (otherwise it was reset away,
        # or the version string was reused by a later push), and we build the
        # OLDEST of them: a newer commit reusing an already-aged version string
        # never gets selected, whatever ended up in the ledger.
        matches = [c for c in ancestry if srcinfo(c) == v]
        if recorded not in matches:
            saw_yank = True
            continue
        return "build", {"version": v, "repo": repo, "commit": matches[-1],
                         "installed": installed,
                         "last_modified": entry["last_modified"]}

    return ("yanked" if saw_yank else "none"), None


def cmd_upgrade(args):
    ensure_dirs()
    rows = load_ledger()
    deny = local_denylist()
    feed = load_feed_names()
    sudo, flags = resolve_sudo(args)
    cutoff = now() - DAYS * 86400
    names, is_auto = targets(args.pkgs)
    print(f"cooldown {DAYS} days: eligible if pushed on or before {day(cutoff)}\n")

    plan, cooling, unobserved = [], [], []
    up_to_date = 0
    for pkg in names:
        action, d = resolve(pkg, cutoff, rows, deny, feed, is_auto)
        if action == "build":
            change = (f"{d['installed']} -> {d['version']}" if d["installed"]
                      else f"install {d['version']}")
            print(f"  {pkg:30} {change} (pushed {day(d['last_modified'])})")
            plan.append((pkg, d))
        elif action == "denied":
            print(f"  {pkg:30} frozen by denylist, skipped")
        elif action == "yanked":
            print(f"  {pkg:30} aged version no longer in canonical history, waiting")
        elif action == "error":
            print(f"  {pkg:30} error: {d['msg']}")
        elif action == "none" and d and d["state"] == "cooling":
            cooling.append((pkg, d))
        elif action == "none" and d and d["state"] == "unobserved":
            unobserved.append(pkg)
        else:  # up-to-date, not-installed, or observed-and-current
            up_to_date += 1

    if cooling:
        print("\nstill cooling down (held until aged in):")
        for pkg, d in sorted(cooling, key=lambda t: t[1]["eligible"]):
            wait = max(0, (d["eligible"] - now()) // 86400 + 1)
            print(f"  {pkg:30} {d['version']:20} eligible {day(d['eligible'])} "
                  f"(in {wait}d)")
    if unobserved:
        print("\nnot yet observed (run 'aur-cooldown observe' a few times):")
        for pkg in sorted(unobserved):
            print(f"  {pkg}")

    tail = f"{up_to_date} up to date, {len(cooling)} cooling down"
    if unobserved:
        tail += f", {len(unobserved)} not yet observed"
    print(f"\n{tail}.")

    if not plan:
        return
    if args.dry_run:
        print("\nDry run; re-run without --dry-run to build and install.")
        return
    if not args.yes:
        if not sys.stdin.isatty():
            sys.exit("aur-cooldown: not a terminal; pass -y to build without asking.")
        try:
            reply = input(f"\n:: Build and install {len(plan)} package(s)? [Y/n] ")
        except EOFError:
            reply = "n"
        if reply.strip().lower() not in ("", "y", "yes"):
            print("aborted.")
            return

    # We drive root ourselves (like yay does) rather than let makepkg -si pick
    # sudo: the user may escalate with su, and makepkg would otherwise fail.
    # Build everything as the normal user first, then install all the results
    # in one transaction, so su is asked for the password only once.
    failed, ready = [], []   # ready: (pkg, build_dir, [artifacts])
    for pkg, d in plan:
        build = os.path.join(CACHE, "build", pkg)
        shutil.rmtree(build, ignore_errors=True)
        os.makedirs(build, exist_ok=True)
        # Export the exact pinned commit as a plain tree with no .git. yay -B is
        # unusable here: it treats the build dir as a git clone to update to the
        # latest commit, which both errors on our export and would defeat the
        # point of building an older, vetted revision.
        tar = subprocess.run(
            ["git", "-C", d["repo"], "archive", "--format=tar", d["commit"]],
            check=True, stdout=subprocess.PIPE)
        subprocess.run(["tar", "-x", "-C", build], input=tar.stdout, check=True)
        print(f"\nbuilding {pkg} {d['version']} (AUR revision {d['commit'][:8]})")

        if not install_deps(build, sudo, flags):
            print(f"  -> could not install dependencies for {pkg} "
                  f"(AUR dependencies are not resolved; install them first)")
            failed.append(pkg)
            continue
        if subprocess.run(["makepkg", "-f", "--noconfirm"], cwd=build).returncode:
            failed.append(pkg)
            continue
        artifacts = [p for p in sorted(glob.glob(os.path.join(build, "*.pkg.tar.*")))
                     if not p.endswith(".sig") and "-debug-" not in os.path.basename(p)]
        if not artifacts:
            print(f"  -> makepkg produced no package for {pkg}")
            failed.append(pkg)
            continue
        ready.append((pkg, build, artifacts))

    built = []
    if ready:
        files = [f for _, _, arts in ready for f in arts]
        print(f"\ninstalling {len(ready)} package(s)")
        rc = run_root(["pacman", "-U", "--noconfirm", *files], sudo, flags)
        if rc == 0:
            built = [pkg for pkg, _, _ in ready]
            for _, build, _ in ready:
                shutil.rmtree(build, ignore_errors=True)
        else:
            failed += [pkg for pkg, _, _ in ready]
    print(f"\nbuilt: {', '.join(built) or 'none'}"
          + (f"  failed: {', '.join(failed)}" if failed else ""))


# --- status / refresh --------------------------------------------------------

def cmd_status(args):
    rows = load_ledger()
    feed = load_feed_names()
    last = int(open(LASTOBS).read()) if os.path.exists(LASTOBS) else 0
    if last:
        print(f"last observe: {time.strftime('%Y-%m-%d %H:%M', time.localtime(last))} "
              f"({(now() - last) // 86400}d ago)")
    else:
        print("last observe: never (run 'aur-cooldown observe')")
    cutoff = now() - DAYS * 86400
    tracked = {r["pkg"] for r in rows}
    print(f"cooldown: {DAYS} days   tracked: {len(tracked)}   "
          f"frozen by feed: {len(feed)}\n")

    by = {}
    for r in rows:
        by.setdefault(r["pkg"], []).append(r)
    for pkg in sorted(by):
        entries = sorted(by[pkg], key=lambda r: r["last_modified"])
        tip = entries[-1]
        if pkg in feed:
            ready = "frozen (denylist feed)"
        else:
            aged = [e for e in entries
                    if e["last_modified"] <= cutoff and e.get("commit")]
            ready = (f"{aged[-1]['version']} (pushed {day(aged[-1]['last_modified'])})"
                     if aged else "none yet")
        print(f"  {pkg:28} eligible: {ready:42} tip: {tip['version']} "
              f"(pushed {day(tip['last_modified'])})")


def cmd_refresh(args):
    ensure_dirs()
    if not os.path.exists(FEEDSCONF):
        print(f"no denylist feeds configured ({FEEDSCONF})")
        return
    names = refresh_feeds()
    print(f"{len(names)} package name(s) frozen, cached at {FEED_CACHE}")


# --- setup -------------------------------------------------------------------

def share_dir():
    """Locate the installed data directory (nudge.sh, yay-init.lua).

    Works both from an installed prefix (bin/aur-cooldown -> share/aur-cooldown)
    and from a source checkout (./aur-cooldown -> ./contrib).
    """
    exe = os.path.realpath(sys.argv[0])
    for cand in (os.path.join(os.path.dirname(os.path.dirname(exe)), "share", "aur-cooldown"),
                 os.path.join(os.path.dirname(exe), "contrib"),
                 "/usr/share/aur-cooldown", "/usr/local/share/aur-cooldown"):
        if os.path.isdir(cand):
            return cand
    return None


def shell_rc():
    sh = os.path.basename(os.environ.get("SHELL", ""))
    if "zsh" in sh:
        return os.path.join(HOME, ".zshrc"), "zsh"
    if "bash" in sh:
        return os.path.join(HOME, ".bashrc"), "bash"
    return None, sh or "sh"


def detect_yay_escalator():
    """Read the user's shell rc for a 'yay --sudo=<bin>' preference.

    Users who escalate with su typically set it once as a yay alias
    (alias yay='yay --sudo=su'); mirroring it means 'upgrade' installs the
    same way yay does without extra configuration. Returns (bin, flags) or None.
    """
    rc, _ = shell_rc()
    if not rc or not os.path.exists(rc):
        return None
    for line in open(rc):
        if "yay" not in line or "--sudo" not in line:
            continue
        mbin = re.search(r"--sudo[=\s]+(\S+)", line)
        if not mbin:
            continue
        mflags = re.search(r"--sudoflags[=\s]+(\"[^\"]*\"|'[^']*'|\S+)", line)
        flags = mflags.group(1).strip("\"'") if mflags else ""
        return mbin.group(1).strip("\"'"), flags
    return None


def strip_block(text, start, end):
    out, skipping = [], False
    for line in text.splitlines():
        if line.strip() == start:
            skipping = True
            continue
        if line.strip() == end:
            skipping = False
            continue
        if not skipping:
            out.append(line)
    while out and not out[-1].strip():
        out.pop()
    return "\n".join(out)


def write_block(path, start, end, body, mode):
    """Create, replace, or remove a marker-delimited block in a file."""
    existing = open(path).read() if os.path.exists(path) else ""
    if mode == "print":
        return f"    would edit {path}:\n{start}\n{body}\n{end}"
    if mode == "revert":
        if start not in existing:
            return f"    {path}: no aur-cooldown block"
        os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
        stripped = strip_block(existing, start, end)
        open(path, "w").write(stripped + "\n" if stripped else "")
        return f"    {path}: removed"
    had = start in existing
    stripped = strip_block(existing, start, end)
    block = f"{start}\n{body}\n{end}"
    new = (stripped + "\n\n" + block if stripped else block) + "\n"
    os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
    open(path, "w").write(new)
    return f"    {path}: {'updated' if had else 'added'}"


def cmd_setup(args):
    mode = "print" if args.print_only else "revert" if args.revert else "apply"
    share = share_dir()
    if share is None:
        sys.exit("aur-cooldown: cannot find the data directory (nudge.sh, yay-init.lua)")

    print({"apply": "aur-cooldown setup:",
           "print": "aur-cooldown setup (preview only, nothing written):",
           "revert": "aur-cooldown setup --revert:"}[mode])

    # 1. yay hook -> ~/.config/yay/init.lua
    yay_init = os.path.join(XDG_CONFIG, "yay", "init.lua")
    ystart, yend = "-- >>> aur-cooldown >>>", "-- <<< aur-cooldown <<<"
    current = open(yay_init).read() if os.path.exists(yay_init) else ""
    if mode == "apply" and shutil.which("yay") is None:
        print(f"    {yay_init}: yay not found on PATH; skipping the hook.\n"
              f"      Install yay (v13+) and re-run 'aur-cooldown setup' to add it.")
    elif mode == "apply" and ystart not in current and "UpgradeSelect" in current:
        print(f"    {yay_init}: another UpgradeSelect hook is present; not touching it.\n"
              f"      Merge {os.path.join(share, 'yay-init.lua')} by hand, or remove the old hook.")
    else:
        hook = open(os.path.join(share, "yay-init.lua")).read().strip()
        print(write_block(yay_init, ystart, yend, hook, mode))

    # 2. ledger reminder -> shell rc
    rc, shell = shell_rc()
    sstart, send = "# >>> aur-cooldown >>>", "# <<< aur-cooldown <<<"
    nudge = os.path.join(share, "nudge.sh")
    if rc is None:
        print(f"    shell '{shell}' not recognised; add this to your rc file yourself:\n"
              f"      . {nudge}")
    else:
        print(write_block(rc, sstart, send, f'[ -f "{nudge}" ] && . "{nudge}"', mode))

    # 3. mirror yay's escalator (yay --sudo=<bin>) into our config, so upgrade
    #    installs the same way yay does. Only when the user hasn't set one.
    esc = detect_yay_escalator()
    if esc and esc[0] != "sudo":
        sudo, sudoflags = esc
        if mode == "print":
            print(f"    would set 'sudo = {sudo}' in {CONFIGFILE} "
                  f"(matching your yay --sudo)")
        elif mode == "apply" and not read_config().get("sudo"):
            os.makedirs(CONFDIR, exist_ok=True)
            with open(CONFIGFILE, "a") as f:
                f.write(f"sudo = {sudo}\n")
                if sudoflags:
                    f.write(f"sudoflags = {sudoflags}\n")
            print(f"    {CONFIGFILE}: sudo = {sudo}"
                  f"{' ' + sudoflags if sudoflags else ''} (from your yay --sudo)")

    if mode == "apply":
        print("\nDone. Open a new shell for the reminder, then run 'aur-cooldown observe'.")
    elif mode == "print":
        print("\nRe-run without --print to apply.")


def main():
    parser = argparse.ArgumentParser(
        prog="aur-cooldown", description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--version", action="version",
                        version=f"aur-cooldown {VERSION}")
    sub = parser.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("observe", help="record current versions and push times")
    p.add_argument("pkgs", nargs="*")
    p.set_defaults(fn=cmd_observe)

    p = sub.add_parser("upgrade", help="install versions that aged past the cooldown")
    p.add_argument("--dry-run", action="store_true",
                   help="show what would be built, install nothing")
    p.add_argument("-y", "--yes", action="store_true",
                   help="build and install without asking for confirmation")
    p.add_argument("--sudo", metavar="BIN",
                   help="command used to gain root (default: sudo, else su)")
    p.add_argument("--sudoflags", metavar="FLAGS",
                   help="extra flags passed to the sudo command")
    p.add_argument("pkgs", nargs="*")
    p.set_defaults(fn=cmd_upgrade)

    p = sub.add_parser("status", help="show eligible versions vs current tips")
    p.add_argument("pkgs", nargs="*")
    p.set_defaults(fn=cmd_status)

    p = sub.add_parser("refresh", help="re-fetch the denylist feeds")
    p.set_defaults(fn=cmd_refresh)

    p = sub.add_parser("setup", help="wire the yay hook and shell reminder into your config")
    p.add_argument("--print", dest="print_only", action="store_true",
                   help="show what would change, write nothing")
    p.add_argument("--revert", action="store_true", help="remove what setup added")
    p.set_defaults(fn=cmd_setup)

    args = parser.parse_args()
    try:
        args.fn(args)
    except (urllib.error.URLError, json.JSONDecodeError) as e:
        print(f"aur-cooldown: network error: {e}", file=sys.stderr)
        sys.exit(1)
    except subprocess.CalledProcessError as e:
        print(f"aur-cooldown: command failed: {' '.join(e.cmd)}\n{e.stderr or ''}",
              file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
